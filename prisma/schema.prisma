generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  password          String
  balance           Float     @default(0.0)
  role              String    @default("USER")
  apiKey            String    @unique @default(uuid())
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deposits          Deposit[]
  orders            Order[]
  tickets           Ticket[]
  notifications     Notification[]
  isProfitViewer    Boolean   @default(false)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          String
  providerOrderId String
  service         String
  link            String
  quantity        Int
  charge          Float
  startCount      Int      @default(0)
  remains         Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  refillRequested Boolean  @default(false)
  refillStatus    String?   // PENDING, APPROVED, REJECTED
  rating          Int?
  review          String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Deposit {
  id           Int      @id @default(autoincrement())
  userId       String
  method       String
  amount       Float
  receiptImage String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id        Int      @id @default(autoincrement())
  userId    String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  senderId  String
  role      String   // "USER" or "ADMIN"
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int      @default(5)
  avatarUrl String?
  createdAt DateTime @default(now())
}

model Service {
  id           Int      @id
  name         String
  category     String
  provider     String   @default("smmcpan")
  originalRate Float
  customRate   Float?
  min          Int
  max          Int
  refill       Boolean  @default(false)
  description  String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model SecurityLog {
  id        String   @id @default(cuid())
  ip        String
  event     String
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())
}

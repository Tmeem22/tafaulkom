generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  password          String
  balance           Float     @default(0.0)
  points            Int       @default(0)
  role              String    @default("USER")
  apiKey            String    @unique @default(uuid())
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deposits          Deposit[]
  orders            Order[]
  tickets           Ticket[]
  notifications     Notification[]
  videoTasks        VideoTask[]
  isProfitViewer    Boolean   @default(false)
  // Affiliate System
  referralCode      String?   @unique
  referredById      String?
  referredBy        User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]    @relation("Referrals")
  commissionsEarned Referral[] @relation("CommissionEarner")
  commissionsSource Referral[] @relation("CommissionSource")
  totalCommission   Float     @default(0.0)
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String
  orderId       Int
  orderAmount   Float
  commission    Float
  createdAt     DateTime @default(now())
  referrer      User     @relation("CommissionEarner", fields: [referrerId], references: [id])
  referred      User     @relation("CommissionSource", fields: [referredId], references: [id])
}

model VideoTask {
  id        String   @id @default(cuid())
  userId    String
  videoUrl  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  points    Int      @default(250)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          String
  providerOrderId String
  service         String
  link            String
  quantity        Int
  charge          Float
  startCount      Int      @default(0)
  remains         Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  refillRequested Boolean  @default(false)
  refillStatus    String?   // PENDING, APPROVED, REJECTED
  rating          Int?
  review          String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Deposit {
  id           Int      @id @default(autoincrement())
  userId       String
  method       String
  amount       Float
  receiptImage String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id        Int      @id @default(autoincrement())
  userId    String
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  senderId  String
  role      String   // "USER" or "ADMIN"
  message   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int      @default(5)
  avatarUrl String?
  createdAt DateTime @default(now())
}

model Service {
  id           Int      @id
  name         String
  category     String
  provider     String   @default("smmcpan")
  originalRate Float
  customRate   Float?
  min          Int
  max          Int
  refill       Boolean  @default(false)
  description  String?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

model SecurityLog {
  id        String   @id @default(cuid())
  ip        String
  event     String
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("percentage") // "percentage" or "fixed"
  discountValue Float
  minOrder      Float    @default(0)
  maxUses       Int      @default(100)
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model SpinResult {
  id        String   @id @default(cuid())
  userId    String
  prize     String
  value     Float
  createdAt DateTime @default(now())
}
